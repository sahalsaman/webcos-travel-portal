# Server only. Use the same cluster as Voibee during cutover.
MONGODB_URI=mongodb://127.0.0.1:27017/travels_connection
PLATFORM_DATABASE=travels_platform
AUTH_SECRET=replace-with-a-long-random-secret
# Keep AUTH_URL unset: Auth.js must use each request's portal/site origin.
# Optional local-only shortcut. Omit in production when hosts identify businesses.
DEFAULT_BUSINESS_SLUG=voibee

# Bootstrap only; remove the password from deployment env after provisioning.
SUPER_ADMIN_EMAIL=owner@example.com
SUPER_ADMIN_PASSWORD=replace-with-a-strong-password
# Register the EXISTING Voibee database without moving or rewriting its records.
VOIBEE_DATABASE=voibee
VOIBEE_PORTAL_HOST=voibee.localhost:3001
VOIBEE_SITE_URL=http://localhost:3000

# Agency payment credentials; never put these in a NEXT_PUBLIC variable.
BUSINESS_PAYMENT_CREDENTIALS={"voibee":{"keyId":"","keySecret":""}}
