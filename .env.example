# Server only. Use the same cluster as Voibee during cutover.
MONGODB_URI=mongodb://127.0.0.1:27017/travels_connection
PLATFORM_DATABASE=TRAVELPORTAL_DEV
AUTH_SECRET=replace-with-a-long-random-secret
# Keep AUTH_URL unset: Auth.js must use each request's portal/site origin.
# Optional local-only shortcut for an agency portal. Omit for the platform admin host.


# Bootstrap only; remove the password from deployment env after provisioning.
SUPER_ADMIN_EMAIL=admin@webcos.com
SUPER_ADMIN_PASSWORD=replace-with-a-strong-password
# Register the Voibee tenant in the development database.



# Optional Redis cache for public storefront reads. Create an Upstash Redis
# database and add these values to the Travels Portal Vercel project as well.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Public content cache lifetime in seconds (default: 120; max: 3600).
REDIS_PUBLIC_CACHE_TTL_SECONDS=120
